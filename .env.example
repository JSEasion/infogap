# ===== 模型接入（至少配一个即可用；全部不配也能用内置示例数据浏览）=====
# DeepSeek 官方 API（推荐起步）：https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=

# vLLM 本地服务（OpenAI 格式，如托管 DeepSeek 开源权重）
VLLM_DSK_BASE_URL=http://127.0.0.1:8000/v1
VLLM_DSK_KEY=EMPTY

# vLLM 本地服务（GLM 格式，如托管 GLM-4.6 / GLM-4-flash 权重）
VLLM_GLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_GLM_KEY=EMPTY

# ===== 搜索 API（可选，二选一；不配则该采集通道禁用）=====
TAVILY_API_KEY=
BOCHA_API_KEY=

# 混合检索（bge-m3 向量 + bge-reranker-v2-m3 精排，OpenAI 兼容端点）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker-v2-m3
